# Keep text files consistent between macOS and Windows.
* text=auto
*.md text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat media and archives as binary.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.psd binary
*.wav binary
*.mp3 binary
*.m4a binary
*.mp4 binary
*.mov binary
*.zip binary
